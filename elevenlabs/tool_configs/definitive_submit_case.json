{
    "type": "webhook",
    "name": "definitive_submit_case",
    "description": "Submits the gathered information, including transcript, history, and risk score, to the clinician dashboard via Retool webhook.",
    "response_timeout_secs": 20,
    "disable_interruptions": false,
    "force_pre_tool_speech": false,
    "assignments": [],
    "tool_call_sound_behavior": "auto",
    "dynamic_variables": {
        "dynamic_variable_placeholders": {}
    },
    "execution_mode": "immediate",
    "api_schema": {
        "request_headers": {},
        "url": "https://renewrx-mocks-demo-2026.netlify.app/api/submit-case",
        "method": "POST",
        "path_params_schema": {},
        "request_body_schema": {
            "type": "object",
            "required": [
                "patientName",
                "transcript",
                "riskScore"
            ],
            "description": "Case submission request",
            "properties": {
                "patientName": {
                    "type": "string",
                    "description": "The full name of the patient."
                },
                "transcript": {
                    "type": "string",
                    "description": "The full conversation transcript."
                },
                "riskScore": {
                    "type": "number",
                    "description": "The calculated risk score from Modulate."
                }
            }
        },
        "content_type": "application/json"
    }
}
